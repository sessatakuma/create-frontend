{
    "name": "sessatakuma-frontend-template",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sessatakuma/create-frontend.git"
    },
    "scripts": {
        "prepare": "husky",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "release": "release-it --config release-it.config.cjs",
        "smoke": "node scripts/smoke-create-frontend.mjs",
        "check": "bun run typecheck && bun run lint && node scripts/check-syntax.mjs && bun run format:check && bun run config:check && bun run build",
        "test": "node --test tests/*.test.mjs",
        "config:check": "node scripts/check-config.mjs --generator",
        "verify:presets": "node scripts/verify-presets.mjs",
        "refresh:locks": "node scripts/refresh-lockfiles.mjs"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,css,scss,html,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "lucide-react": "1.17.0",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "complete-lint": "5.12.0",
        "eslint": "10.4.1",
        "eslint-config-complete": "4.8.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "husky": "9.1.7",
        "lint-staged": "17.0.7",
        "prettier": "3.8.3",
        "release-it": "20.2.0",
        "typescript": "6.0.3",
        "vite": "8.0.16",
        "jsonc-parser": "3.3.1",
        "smol-toml": "1.4.2",
        "yaml": "2.8.1",
        "@clack/prompts": "0.11.0",
        "picocolors": "1.1.1"
    },
    "packageManager": "bun@1.3.9",
    "engines": {
        "node": ">=22.22.2",
        "bun": "1.3.9"
    }
}
