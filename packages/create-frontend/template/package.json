{
    "name": "sessatakuma-frontend-template",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sessatakuma/rail.git"
    },
    "scripts": {
        "prepare": "husky",
        "dev": "vite",
        "build": "vite build",
        "preview": "bun run cf:build && wrangler dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "check": "bun run typecheck && bun run lint && bun run format:check && bun run config:check && bun run cf:build && bun run cf:check",
        "cf:build": "vite build",
        "cf:check": "wrangler deploy --dry-run --outdir=.cloudflare-check",
        "deploy": "bun run cf:build && wrangler deploy --keep-vars",
        "upload": "bun run cf:build && wrangler versions upload --keep-vars",
        "config:check": "node scripts/check-config.mjs",
        "cf:deploy": "wrangler deploy --keep-vars",
        "cf:upload": "wrangler versions upload --keep-vars",
        "lint-staged": "lint-staged"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,css,scss,html,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "lucide-react": "1.17.0",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "complete-lint": "5.12.0",
        "eslint": "10.4.1",
        "eslint-config-complete": "4.8.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "husky": "9.1.7",
        "lint-staged": "17.0.7",
        "prettier": "3.8.3",
        "typescript": "6.0.3",
        "vite": "8.0.16",
        "jsonc-parser": "3.3.1",
        "smol-toml": "1.4.2",
        "yaml": "2.8.1",
        "wrangler": "4.111.0"
    },
    "packageManager": "bun@1.3.9",
    "engines": {
        "node": ">=22.22.2",
        "bun": "1.3.9"
    }
}
